rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;

      match /courses/{courseId} {
        allow read: if isSelf(uid);
        allow write: if false;

        match /wordStats/{wordId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }
      }

      match /dailyStats/{dateId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /inventory/{itemId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /badges/{badgeId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /usernames/{handle} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }

    match /activities/{activityId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Friend-pair sprint streak - written only by api/complete-practice-
    // session.js (Admin SDK bypasses rules); exposed to clients via
    // completePracticeSession's friendsStatus response field instead.
    match /friendships/{pairId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
