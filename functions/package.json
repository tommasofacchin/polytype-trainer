{
  "name": "polytype-trainer-functions",
  "description": "Server-side progression, streak, and social functions for Polytype Trainer.",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "check": "node --check index.js",
    "serve": "npx firebase-tools emulators:start --project demo-polytype-trainer-dev --only auth,functions,firestore,hosting",
    "deploy": "npx firebase-tools deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  }
}
